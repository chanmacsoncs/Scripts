module = {
    
}

for _, restaurant in workspace.__THINGS.Restaurants:GetChildren() do
    PlayerName = restaurant.RestaurantBilboardHost.RestaurantBillboard.Frame.PlayerName.text
    if PlayerName == game.Players.LocalPlayer.DisplayName then 
        module.Restaurant = restaurant
    end
end

task.spawn(function()
    repeat 
        local list = {}
        for _, thing in module.Restaurant.Entities:GetChildren() do
            if not thing:FindFirstChild("HumanoidRootPart") then continue end
            if not thing.HumanoidRootPart:FindFirstChild("ProximityPrompt") then continue end
            if not thing.HumanoidRootPart.ProximityPrompt.ActionText == "Asign Seat" then continue end
            list[#list+1] = thing
        end
        module.WaitingCustomers = list
        task.wait(0.1)
    until false
end)

return module
